{
  "name": "secneo-gadget",
  "author": {
    "email": "diff@protonmail.com",
    "name": "Tim Strazzere"
  },
  "version": "1.0.0",
  "description": "Gadgets for unpacking secneo protected appliciations",
  "private": true,
  "main": "build/index.cjs",
  "type": "module",
  "scripts": {
    "prepare": "npm run build",
    "build": "frida-compile agent/index.ts -o build/_agent.js -c && tsc --build",
    "watch": "frida-compile agent/index.ts -o build/_agent.js -w",
    "lint": "npx @biomejs/biome check --write ./src ./agent ./research",
    "start": "npm run prepare && node build/index.js",
    "spawn": "frida -U -f dji.go.v5 -l build/_agent.js",
    "spawn-pilot": "frida -U -f com.dji.industry.pilot -l build/_agent.js",
    "combine": "tsc && node build/combine.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/cli-progress": "^3.11.0",
    "@types/frida-gum": "^19.12.0",
    "@types/node": "^26.6.6",
    "frida-compile": "^19.1.0",
    "frida-java-bridge": "^7.0.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "cli-progress": "^3.12.0",
    "frida": "^17.25.1",
    "frida-fs": "^8.1.1"
  }
}
